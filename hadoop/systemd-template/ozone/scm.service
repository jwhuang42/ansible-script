[Unit]
Description=Storage Container Manager
After=network.target

[Service]
User={{ ansible_user }}
Group={{ ansible_user }}
Type=simple
EnvironmentFile={{ deploy_dir }}/ozone/etc/hadoop/ozone-env.sh
ExecStart={{ deploy_dir }}/ozone/bin/ozone scm
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target